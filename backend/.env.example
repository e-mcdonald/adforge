# Required from day 1
OPENAI_API_KEY=                     # DALL-E image gen + gpt-4o-mini fallback
ANTHROPIC_API_KEY=                  # Claude Sonnet (strategy/research) + Opus (copy)

# Local model setup (optional — falls back to gpt-4o-mini if unavailable)
OLLAMA_BASE_URL=http://localhost:11434

# Environment
ENV=development                     # switch to "production" for Phase 7

# Phase 7 only — AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=adforge-images-prod
ECR_REGISTRY=                       # your AWS account ECR registry URL
